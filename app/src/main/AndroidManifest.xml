<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used after the person explicitly enables alignment feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />

        <queries>
        <package android:name="org.jpi59.ethicnotes" />
        <package android:name="org.jpi59.ethiccompass" />
        <package android:name="org.jpi59.ethicqrscanner" />
        <package android:name="org.jpi59.teclado" />
        <package android:name="org.jpi59.ethictuner" />
        <package android:name="org.jpi59.ethicupdatesafe" />
        <package android:name="org.jpi59.ethichandoff" />
        <package android:name="org.senda.browser" />
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EthicCompass"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
